{
  "name": "runqora-ui",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "ultracite check && tsc && bun run --filter '*' typecheck",
    "dev": "bun run --filter docs dev",
    "fix": "ultracite fix",
    "registry:build": "bun run --filter docs registry:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.3.6"
}
