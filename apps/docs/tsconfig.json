{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/audit/*": ["./registry/audit/*"],
      "@/components/storage/*": ["./registry/storage/*"],
      "@/components/webhooks/*": ["./registry/webhooks/*"],
      "@/lib/audit/*": ["./registry/lib/audit/*"],
      "@/lib/storage/*": ["./registry/lib/storage/*"],
      "@/lib/webhooks/*": ["./registry/lib/webhooks/*"],
      "@/registry/*": ["./registry/*"],
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
